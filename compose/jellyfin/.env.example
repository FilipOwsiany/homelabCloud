# Keep the version pinned during migrations and test upgrades separately.
JELLYFIN_VERSION=10.11.11

# Jellyfin configuration/database and disposable transcoding/image cache.
JELLYFIN_DATA_ROOT=/srv/data/jellyfin

# Existing media library. It is mounted read-only inside the container.
JELLYFIN_MEDIA_ROOT=/srv/media

# Account used inside the container. It must own DATA_ROOT and be able to read MEDIA_ROOT.
JELLYFIN_UID=1000
JELLYFIN_GID=1000

# For the optional hardware-acceleration override only.
# Find it with: getent group render | cut -d: -f3
# JELLYFIN_RENDER_GID=107

TZ=Europe/Warsaw
