# Persistent data root on the Docker host.
AUTHENTIK_DATA_ROOT=/srv/data/authentik

# Generate both values; do not reuse passwords from another service.
# openssl rand -base64 36 | tr -d '\n'
PG_PASS=replace-with-a-random-postgres-password
# openssl rand -base64 60 | tr -d '\n'
AUTHENTIK_SECRET_KEY=replace-with-a-long-random-secret
