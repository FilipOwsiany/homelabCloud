NEXTCLOUD_DATA_ROOT=/srv/data/nextcloud

MYSQL_DATABASE=nextcloud
MYSQL_USER=nextcloud
MYSQL_PASSWORD=replace-with-a-random-database-password
MYSQL_ROOT_PASSWORD=replace-with-a-different-random-root-password

# These values are used only by a fresh Nextcloud installation.
NEXTCLOUD_ADMIN_USER=admin
NEXTCLOUD_ADMIN_PASSWORD=replace-with-a-random-admin-password

TZ=Europe/Warsaw
